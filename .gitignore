# ---- License generator: NEVER publish ----
# Minting binary + private issued-key log (customer machine IDs)
license-generator/bin/
license-generator/obj/
**/issued_keys.log
*.exe
# Generated key output (contains real machine IDs + issued keys)
license-generator/license_keys_*.csv
license-generator/*_keys.csv
# Archived issued-key data (sensitive: customer machine IDs + issued keys)
license-generator/keys-data/

# ---- Installer packaged outputs (large / regenerable) ----
installer/iexpress/*.zip
installer/*.zip
installer/*.rar
installer/PrintLayoutAddin-Setup/

# ---- Local runtime / license data ----
license.dat

# ---- Test drawings (large binary AutoCAD data, not source) ----
test/
*.bak

# ---- Editor / OS ----
.idea/
*.swp
Thumbs.db
desktop.ini

# ---- Claude Code local settings (per-user, not shared) ----
.claude/settings.local.json
PrintLayoutAddin.bundle/**/*.log