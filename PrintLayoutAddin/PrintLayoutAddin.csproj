<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48      -> AutoCAD 2018-2024 (.NET Framework runtime)
         net8.0-windows -> AutoCAD 2025 and newer (.NET 8 runtime) -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF (ribbon icons) is pulled in via the SDK for the .NET 8 build.
         The net48 build keeps the explicit WPF references below (proven setup). -->
    <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>PrintLayoutAddin</RootNamespace>
    <AssemblyName>PrintLayoutAddin.v201</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Single source of truth for the plugin version (shown in the License dialog). -->
    <Version>2.7.1</Version>
    <AssemblyVersion>2.9.1.0</AssemblyVersion>
    <FileVersion>2.9.1.0</FileVersion>
    <!-- AutoCAD loads this DLL directly (not via `dotnet exec`), so it never reads our
         deps.json to resolve package dependencies from the NuGet cache. Real runtime
         deps (FlexiLicense) must be physically copied next to the output DLL; SDK-style
         Library projects targeting net8.0+ default this to false. AutoCAD-provided SDK
         packages (ModPlus.AutoCAD.API.2025) opt back out via ExcludeAssets="runtime". -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Each target framework lands in its own bin subfolder so the two DLLs never collide. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Local AutoCAD SDK used ONLY for the net48 build. Override with /p:AutoCADPath=... -->
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2018</AutoCADPath>
    <!-- Sheet Set Manager interop (prebuilt by AutoCAD). Prefer AutoCADPath copy so
         `dotnet build` works (COMFileReference / ResolveComReference needs Framework MSBuild). -->
    <AcSmInteropPath Condition="'$(AcSmInteropPath)' == '' and Exists('$(AutoCADPath)\AcSmComponents.Interop.dll')">$(AutoCADPath)\AcSmComponents.Interop.dll</AcSmInteropPath>
    <AcSmInteropPath Condition="'$(AcSmInteropPath)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2024\AcSmComponents.Interop.dll')">C:\Program Files\Autodesk\AutoCAD 2024\AcSmComponents.Interop.dll</AcSmInteropPath>
    <DefineConstants Condition="'$(AcSmInteropPath)' != ''">$(DefineConstants);ACSM_INTEROP</DefineConstants>
  </PropertyGroup>

  <!-- ===================== AutoCAD 2018-2024 : .NET Framework 4.8 ===================== -->
  <!-- References the locally-installed AutoCAD SDK DLLs. CopyLocal=false because AutoCAD
       loads its own copies at runtime - they must NOT be bundled with the plugin. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADPath)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WPF (ribbon icon bitmaps) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <!-- XLSX import (System.IO.Compression + System.Xml.Linq); not auto-referenced for net48 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- ===================== AutoCAD 2025+ : .NET 8 ===================== -->
  <!-- AutoCAD 2025 moved its managed runtime to .NET 8, so a separate DLL is required.
       Reference assemblies (accoremgd, acdbmgd, acmgd, AdWindows, ...) come from NuGet,
       so building for 2025 does NOT require AutoCAD 2025 to be installed locally.
       ExcludeAssets=runtime on the PackageReference below keeps them out of the output
       (AutoCAD provides them) without blocking other packages like FlexiLicense. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- AutoCAD 2025 provides these DLLs at runtime; ExcludeAssets=runtime keeps them
         out of our output while still resolving the compile-time reference. -->
    <PackageReference Include="ModPlus.AutoCAD.API.2025" Version="3.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Sheet Set COM API (AcSm*). Late-bound InvokeMember fails on modern AutoCAD
       ("COM target does not implement IDispatch"); typed interop is required. -->
  <ItemGroup Condition="'$(AcSmInteropPath)' != ''">
    <Reference Include="AcSmComponents.Interop">
      <HintPath>$(AcSmInteropPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlexiLicense" Version="1.5.0" />
  </ItemGroup>

  <!-- Keep the deployable bundle (what install.bat copies) in sync with the freshly built DLLs.
       Each target framework is copied to its own Contents subfolder, matching PackageContents.xml.
       Runs once per inner (per-TFM) build; the empty-TFM outer build is skipped by the condition.
       Copies the WHOLE output folder (not just $(TargetPath)) so runtime dependencies that need
       to sit next to the DLL, FlexiLicense.dll today and whatever gets added later, always follow
       along. Missing just this one file is exactly what silently broke the ribbon-loaded copy:
       Addin Manager pointed straight at bin/Debug and worked; the installed bundle didn't. -->
  <Target Name="CopyToBundle" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <BundleSub Condition="'$(TargetFramework)' == 'net48'">net48</BundleSub>
      <BundleSub Condition="'$(TargetFramework)' == 'net8.0-windows'">net8</BundleSub>
      <BundleContents>$(MSBuildProjectDirectory)\..\PrintLayoutAddin.bundle\Contents\$(BundleSub)</BundleContents>
    </PropertyGroup>
    <ItemGroup>
      <BundleFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(BundleContents)" SkipUnchangedFiles="false" />
  </Target>

</Project>
